# ==========================================
# UPGRADE 2.0 - ENVIRONMENT CONFIGURATION
# ==========================================

# PostgreSQL Production Database URL (Neon, Supabase, Vercel Postgres, Railway):
# Example: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/upgrade?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/upgrade?sslmode=require"

# Authentication Secret (for JWT session tokens - minimum 32 random characters):
# Generate a new random secret with: openssl rand -base64 32
JWT_SECRET="generate-a-secure-random-32-character-secret-for-production"

# Base Application URL:
NEXT_PUBLIC_APP_URL="https://upgrade-one-gold.vercel.app"

# Optional Initial Admin Seed Credentials (used only during prisma db seed):
ADMIN_EMAIL="admin@upgrade.uz"
# Set a strong password in your private environment:
ADMIN_PASSWORD="set-your-strong-admin-password-here"

# Google OAuth (Optional - configure in Google Cloud Console if needed):
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Erbol AI Jotform Agent (When user creates their own agent in Jotform Dashboard):
NEXT_PUBLIC_ERBOL_AI_AGENT_ID=""
